---
import type { IconifyIcon } from "@iconify/types";
import type { HTMLAttributes } from "astro/types";

import { resolveIcon } from "./shared/core.js";
import { cache } from "./cache.js";
import type { CacheEntry } from "./cache.js";

type BaseProps = Omit<HTMLAttributes<"svg">, "name"> & {
  "is:inline"?: boolean;
  title?: string;
  desc?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
};

// @ts-ignore generated by typegen
import type { Icon } from "virtual:astro-iconset";

type Props =
  | (BaseProps & { name: Icon; icon?: never })
  | (BaseProps & { icon: IconifyIcon; name?: never });

class AstroIconError extends Error {
  public hint: string = "";

  constructor(message: string) {
    super(message);
  }
}

const props = Astro.props as Props;
const {
  icon,
  name: nameProp,
  size,
  width,
  height,
  title,
  desc,
  "is:inline": inline = false,
  ...rest
} = props;

if (icon && nameProp != null && String(nameProp).length > 0) {
  throw new AstroIconError('Use either "name" or "icon", not both.');
}

if (
  !icon &&
  (nameProp === undefined ||
    (typeof nameProp === "string" && nameProp.length === 0))
) {
  const err = new AstroIconError('Provide "name" or "icon".');
  if (import.meta.env.DEV) {
    err.hint =
      'Example: <Icon name="md:home" /> or import home from "./home.svg?icon" then <Icon icon={home} />.';
  }
  throw err;
}

const resolved = resolveIcon(
  { name: nameProp as string | undefined, icon, size, width, height, title, desc },
  "astro",
);

const cacheKey = icon ? resolved.symbolId.slice(5) : (nameProp as string);
const req = Astro.request;
const map = cache.get(req) ?? new Map();
const entry = map.get(cacheKey) ?? ({ count: 0, body: "", viewBox: "" }) as CacheEntry;
const isFirstUse = !inline && entry.count === 0;
entry.count++;
map.set(cacheKey, entry);
cache.set(req, map);

if (isFirstUse) {
  entry.body = resolved.symbolBody;
  entry.viewBox = resolved.symbolViewBox;
}

const dataAttr = resolved.dataAttr ? { [resolved.dataAttr.name]: cacheKey } : {};
---

<svg {...resolved.attrs} {...rest} {...dataAttr}>
  {title && <title>{title}</title>}
  {desc && <desc>{desc}</desc>}
  {
    inline ? (
      <Fragment set:html={resolved.symbolBody} />
    ) : (
      <Fragment>
        {isFirstUse && <symbol id={resolved.symbolId} viewBox={resolved.symbolViewBox} set:html={resolved.symbolBody} />}
        <use href={`#${resolved.symbolId}`} />
      </Fragment>
    )
  }
</svg>
